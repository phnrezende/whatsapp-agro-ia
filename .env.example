# Respostas: Dify (o agente do cliente) OU OpenAI com a base local. Sem nenhum: devolve os trechos (modo demo).
DIFY_API_KEY=
DIFY_BASE_URL=https://api.dify.ai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Grátis pelo Hugging Face: OPENAI_API_KEY=hf_... (token com permissão "Inference Providers"),
# OPENAI_BASE_URL=https://router.huggingface.co/v1 e OPENAI_MODEL=meta-llama/Llama-3.1-8B-Instruct
OPENAI_BASE_URL=

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Asaas: o token que você define ao cadastrar o webhook, e o link de assinatura
ASAAS_WEBHOOK_TOKEN=
PAYMENT_LINK=

# Perguntas por dia, por IP, no chat web (/chat)
CHAT_DAILY_LIMIT=20

# 1 liga o chat web (/ e /chat) e a rota /ask, para testar sem o WhatsApp. Deixe vazio em produção.
DEMO=
